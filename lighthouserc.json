{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "isSinglePageApplication": true,
      "url": ["/"],
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage --headless=new"
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance":     ["warn",  { "minScore": 0.80 }],
        "categories:accessibility":   ["warn",  { "minScore": 0.85 }],
        "categories:best-practices":  ["warn",  { "minScore": 0.85 }],
        "categories:seo":             ["warn",  { "minScore": 0.85 }],
        "first-contentful-paint":     ["warn",  { "maxNumericValue": 3000 }],
        "interactive":                ["warn",  { "maxNumericValue": 6000 }],
        "cumulative-layout-shift":    ["warn",  { "maxNumericValue": 0.15 }],
        "total-blocking-time":        ["warn",  { "maxNumericValue": 400  }],
        "uses-text-compression":      ["warn",  { "minScore": 1 }],
        "uses-long-cache-ttl":        ["warn",  { "minScore": 0.8 }],
        "render-blocking-resources":  ["warn",  { "maxLength": 2 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
